# PostgreSQL 접속 문자열
DATABASE_URL=postgres://labelrep:labelrep@localhost:5432/labelrep

# 투표/신고 fingerprint 및 요약 토큰 서명용 비밀키 (운영에서는 반드시 긴 랜덤 문자열로 교체)
APP_SECRET=change-me-to-a-long-random-string

# X-Forwarded-For를 덧붙이는 리버스 프록시(Nginx, 로드밸런서) 뒤에서만 true.
# 오른쪽 끝에서 TRUST_PROXY_HOPS번째 값을 클라이언트 IP로 사용 (프록시 수에 맞출 것)
TRUST_PROXY=false
TRUST_PROXY_HOPS=1

# 쓰기 API(CSRF 검사)에서 SITE_URL 외에 허용할 Origin (쉼표 구분, 보통 비워둠)
ALLOWED_ORIGINS=

# 사이트 절대 URL (canonical, OG, sitemap)
SITE_URL=http://localhost:3000

# AI 3줄 요약 — 비워두면 로컬 추출 요약(fallback)만 사용
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-opus-5

# 보드 개설 요청 자동 승격 임계치
BOARD_PROMOTION_THRESHOLD=50

PORT=3000

# 신뢰도 배지 배치 주기(초). 0이면 서버 내장 스케줄러 끔 (그 경우 npm run trust:refresh 를 cron으로)
TRUST_REFRESH_INTERVAL_SEC=120

# AI 큐레이터 "활성화 유지" 스케줄러 주기(초), 0이면 끔
CURATOR_INTERVAL_SEC=1800
# 이 시각 이후 AI 큐레이터 게시 중단 (예: 오픈 후 6주). 비우면 물러남 정책만 적용
CURATOR_ACTIVE_UNTIL=

# 운영 대시보드(/admin) 비밀번호 — 비우면 대시보드 비활성(404)
ADMIN_PASSWORD=
# 보드 요청 후 자동 승격까지 최소 대기 시간
BOARD_PROMOTION_MIN_AGE_HOURS=24
# 어뷰징 탐지·보류 승격·데이터 정리 배치 주기(초)
MAINTENANCE_INTERVAL_SEC=300

# ---- Sprint 6: 오픈 준비 ----
# 개인정보처리방침·권리침해 신고 창구 연락처 (운영 필수)
CONTACT_EMAIL=
# 개인정보처리방침에 표시할 운영 주체
OPERATOR_NAME=
# 서버·DB 호스팅 사업자 (개인정보 처리위탁 고지용, 예: "AWS 서울 리전")
HOSTING_PROVIDER=
# 법률 검토를 마친 약관·방침의 시행일 (YYYY-MM-DD). 비우면 "검토 전 초안" 배너가 표시됨
LEGAL_EFFECTIVE_DATE=
# Docker 컨테이너 시작 시 마이그레이션 적용 (여러 인스턴스면 한 곳에서만)
RUN_MIGRATIONS=false
# 로컬에서 운영 빌드를 시험할 때만: 환경변수 오류를 경고로 낮춤 (운영 배포 금지)
# ENV_CHECK=warn

# ---- Sprint 7 ----
# 레이트 리밋 저장소: postgres(여러 인스턴스 공유, 운영 기본) / memory(단일 프로세스, 개발 기본)
# RATE_LIMIT_BACKEND=postgres

# ---- Sprint 8 ----
# 보드 주간 다이제스트 배치 주기(초), 0이면 끔
DIGEST_INTERVAL_SEC=3600

# ---- Sprint 10 ----
# 웹 워커 프로세스 수 (기본 1, "auto" = CPU 수). 2 이상이면 node:cluster 로 코어를 모두 쓴다.
# 전체 DB 커넥션 ≈ (DB_POOL_MAX + 1) × 워커 수 × 인스턴스 수 — Postgres max_connections(기본 100) 안에 들어오게.
# WEB_CONCURRENCY=auto
# 프로세스당 DB 커넥션 풀 크기 (기본 10)
# DB_POOL_MAX=10

# ---- Sprint 12: 이미지 첨부 ----
# 저장소: local(기본, UPLOAD_DIR) 또는 s3(AWS S3·Cloudflare R2·MinIO 등 S3 호환)
IMAGE_STORAGE=local
# local 일 때 저장 경로 (컨테이너라면 볼륨으로 연결 — docker-compose.yml 참고)
UPLOAD_DIR=./data/uploads
# s3 일 때 (path-style 주소 사용: <S3_ENDPOINT>/<S3_BUCKET>/img/…). 버킷은 비공개로 두세요 — 이미지는 /media 로만 제공됩니다.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=labelrep-images
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
