# PostgreSQL 접속 문자열
DATABASE_URL=postgres://labelrep:labelrep@localhost:5432/labelrep

# 투표/신고 fingerprint 및 요약 토큰 서명용 비밀키 (운영에서는 반드시 긴 랜덤 문자열로 교체)
APP_SECRET=change-me-to-a-long-random-string

# X-Forwarded-For를 덧붙이는 리버스 프록시(Nginx, 로드밸런서) 뒤에서만 true.
# 오른쪽 끝에서 TRUST_PROXY_HOPS번째 값을 클라이언트 IP로 사용 (프록시 수에 맞출 것)
TRUST_PROXY=false
TRUST_PROXY_HOPS=1

# 쓰기 API(CSRF 검사)에서 SITE_URL 외에 허용할 Origin (쉼표 구분, 보통 비워둠)
ALLOWED_ORIGINS=

# 사이트 절대 URL (canonical, OG, sitemap)
SITE_URL=http://localhost:3000

# AI 3줄 요약 — 비워두면 로컬 추출 요약(fallback)만 사용
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-opus-5
# Sprint 20: 라벨 사진 읽기 (키가 있으면 글쓰기 사진에 "🔍 라벨 읽기" 버튼). 사진을 누를 때만 그 사진 한 장을 보냅니다.
LABEL_MODEL=claude-opus-5
# 하루(최근 24시간) 전체 라벨 읽기 한도 — 비용 상한. 0이면 끕니다. 같은 사진은 한 번만 읽습니다.
LABEL_READ_DAILY_MAX=300

# 방 만들기에 필요한 동의 수의 상한 — 실제 필요 인원은 최근 30일 활동 인원의 5% (최소 3명, Sprint 39)
BOARD_PROMOTION_THRESHOLD=50

PORT=3000

# 신뢰도 배지 배치 주기(초). 0이면 서버 내장 스케줄러 끔 (그 경우 npm run trust:refresh 를 cron으로)
TRUST_REFRESH_INTERVAL_SEC=120

# AI 큐레이터 "활성화 유지" 스케줄러 주기(초), 0이면 끔
CURATOR_INTERVAL_SEC=1800
# 이 시각 이후 AI 큐레이터 게시 중단 (예: 오픈 후 6주). 비우면 물러남 정책만 적용
CURATOR_ACTIVE_UNTIL=
# (Sprint 37) 시드가 떨어진 보드는 AI가 새 글을 써서 사람 검수 없이 게시 (안전 검사 통과 시). 0 이면 끔. ANTHROPIC_API_KEY 가 없으면 자동으로 꺼짐
CURATOR_AUTOGEN=1
# AI 새 글 시도(게시·탈락·실패 모두) 하루 한도 — API 비용 상한
CURATOR_AUTOGEN_DAILY_MAX=10

# 운영 대시보드(/admin) 비밀번호 — 비우면 대시보드 비활성(404)
ADMIN_PASSWORD=
# 보드 요청 후 자동 승격까지 최소 대기 시간
BOARD_PROMOTION_MIN_AGE_HOURS=24
# 어뷰징 탐지·보류 승격·데이터 정리 배치 주기(초)
MAINTENANCE_INTERVAL_SEC=300

# ---- Sprint 6: 오픈 준비 ----
# 개인정보처리방침·권리침해 신고 창구 연락처 (운영 필수)
CONTACT_EMAIL=
# 개인정보처리방침에 표시할 운영 주체
OPERATOR_NAME=
# 서버·DB 호스팅 사업자 (개인정보 처리위탁 고지용, 예: "AWS 서울 리전")
HOSTING_PROVIDER=
# 법률 검토를 마친 약관·방침의 시행일 (YYYY-MM-DD). 비우면 "검토 전 초안" 배너가 표시됨
LEGAL_EFFECTIVE_DATE=
# Docker 컨테이너 시작 시 마이그레이션 적용 (여러 인스턴스면 한 곳에서만)
RUN_MIGRATIONS=false
# 로컬에서 운영 빌드를 시험할 때만: 환경변수 오류를 경고로 낮춤 (운영 배포 금지)
# ENV_CHECK=warn

# ---- Sprint 7 ----
# 레이트 리밋 저장소: postgres(여러 인스턴스 공유, 운영 기본) / memory(단일 프로세스, 개발 기본)
# RATE_LIMIT_BACKEND=postgres

# ---- Sprint 8 ----
# 보드 주간 다이제스트 배치 주기(초), 0이면 끔
DIGEST_INTERVAL_SEC=3600

# ---- Sprint 10 ----
# 웹 워커 프로세스 수 (기본 1, "auto" = CPU 수). 2 이상이면 node:cluster 로 코어를 모두 쓴다.
# 전체 DB 커넥션 ≈ (DB_POOL_MAX + 1) × 워커 수 × 인스턴스 수 — Postgres max_connections(기본 100) 안에 들어오게.
# WEB_CONCURRENCY=auto
# 프로세스당 DB 커넥션 풀 크기 (기본 10)
# DB_POOL_MAX=10

# ---- Sprint 12: 이미지 첨부 ----
# 저장소: local(기본, UPLOAD_DIR) 또는 s3(AWS S3·Cloudflare R2·MinIO 등 S3 호환)
IMAGE_STORAGE=local
# local 일 때 저장 경로 (컨테이너라면 볼륨으로 연결 — docker-compose.yml 참고)
UPLOAD_DIR=./data/uploads
# s3 일 때 (path-style 주소 사용: <S3_ENDPOINT>/<S3_BUCKET>/img/…). 버킷은 비공개로 두세요 — 이미지는 /media 로만 제공됩니다.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=labelrep-images
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- Sprint 13: 출처 ----
# 출처 링크 생존 확인 배치 주기(초), 0이면 끔. 서버에서 외부 사이트로 요청을 보냅니다 (사설·내부 주소는 차단).
SOURCE_CHECK_INTERVAL_SEC=900

# ---- Sprint 16: 푸시 알림 (선택) ----
# `npm run push:keys` 로 만든 두 줄을 넣으면 /me 에서 관심 제품·지켜보는 글 푸시 알림을 켤 수 있습니다. 비우면 푸시 없이 앱 안 알림만.
# 알림을 켠 브라우저에 한해 푸시 주소·관심 목록을 저장합니다 (끄면 즉시, 90일 미사용 시 자동 삭제).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# 알림 배치 주기(초), 한 구독에 알림을 보내는 최소 간격(초)
PUSH_INTERVAL_SEC=600
PUSH_MIN_GAP_SEC=3600

# ---- Sprint 18: 운영 ----
# 운영 알림 웹훅 (Slack·Discord 호환) — 새 서버 오류·재발·급증. 비우면 /admin 에서만 확인
# ALERT_WEBHOOK_URL=
# 백업 (npm run db:backup / docker compose 의 backup 서비스)
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
# BACKUP_INTERVAL_SEC=86400

# ---- Sprint 19: PWA·오프라인 ----
# 서비스 워커 비상 해제. 서비스 워커 때문에 사이트가 제대로 안 열리면 1 로 두고 재시작 → 각 브라우저가 다음 접속 때
# 서비스 워커와 이 기기의 저장한 글을 지웁니다 (푸시 알림도 꺼짐). 원인을 고쳐 배포한 뒤 다시 비우세요.
# SW_DISABLED=

# ---- Sprint 24: HTTPS 리버스 프록시 (docker compose --profile https) ----
# 실제 서비스는 이 구성으로: Caddy 가 인증서를 자동으로 받아 443 에서 받고 앱(127.0.0.1:3000)으로 넘깁니다.
# 이때 SITE_URL=https://<DOMAIN>, TRUST_PROXY=true, TRUST_PROXY_HOPS=1 로 맞추세요.
# DOMAIN=nobangjang.com
# ACME_EMAIL=ops@example.com
# 도메인 없이 사내·리허설용으로 띄울 때만: CADDY_TLS=tls internal
# CADDY_TLS=

# ---- Sprint 27: DB 장애 시 읽기 전용 모드 ----
# 0번 워커가 주기마다 공개 페이지(홈·보드·추천 많은/최근 글·글 많은 제품·규칙 문서)를 아무 기록 없는 방문자로 받아 저장해 두고,
# DB 에 닿지 못하면 그 저장본을 "읽기 전용" 안내와 함께 보여줍니다. 0 이면 끕니다.
# SNAPSHOT_INTERVAL_SEC=600
# SNAPSHOT_POSTS=100
# SNAPSHOT_PRODUCTS=50
# 저장 위치 (기본 ./data/snapshots — 컨테이너 안이라 다시 만들면 비워지고, 곧 다시 채워집니다)
# SNAPSHOT_DIR=
# DB 연결을 기다리는 최대 시간(ms). 응답 없는 DB 에 요청이 매달리지 않게
# DB_CONNECT_TIMEOUT_MS=5000
