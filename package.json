{
  "name": "label-republic",
  "version": "0.1.0",
  "private": true,
  "description": "노방장 — 방장 없는 덕후 팩트체크 커뮤니티",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build",
    "start": "NODE_ENV=production node --import tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "trust:refresh": "tsx scripts/refresh-trust.ts",
    "summary:backfill": "tsx scripts/backfill-summaries.ts",
    "seed:curator": "tsx scripts/seed-curator.ts",
    "curator:generate": "tsx scripts/curator-generate.ts",
    "sources:backfill": "tsx scripts/backfill-sources.ts",
    "perf:load": "tsx scripts/perf/load.ts",
    "perf:queries": "tsx scripts/perf/queries.ts",
    "perf:jobs": "tsx scripts/perf/jobs.ts",
    "push:keys": "tsx scripts/push-keys.ts",
    "db:backup": "tsx scripts/backup.ts backup",
    "db:backup:verify": "tsx scripts/backup.ts verify",
    "db:restore": "tsx scripts/backup.ts restore",
    "perf:mobile": "node scripts/perf/mobile.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "aws4fetch": "^1.0.20",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "axe-core": "^4.13.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
